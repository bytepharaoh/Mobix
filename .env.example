# Local Compose values. The gateway binds loopback only.
GATEWAY_PORT=8080
# Development-only credentials. Change these before sharing an environment.
MOBIX_BOOTSTRAP_EMAIL=operator@mobix.test
MOBIX_BOOTSTRAP_PASSWORD=mobix-local-operator-password
MOBIX_INTERNAL_KEY=mobix-local-internal-key-replace-before-sharing
ACCOUNTS_MONGO_DB=mobix_accounts
MONGO_USER=admin
MONGO_PASSWORD=password
MONGO_DB=mobix
PAYMENT_MONGO_DB=mobix_payment
RABBITMQ_DEFAULT_USER=mobix
RABBITMQ_DEFAULT_PASS=mobix-local

# Automatic driver matching
DISPATCH_BATCH_SIZE=3
DISPATCH_RADIUS_METERS=8000
DISPATCH_LOCATION_MAX_AGE=90s
DISPATCH_OFFER_TTL=15s
