  },
  "components": {
    "schemas": {
      "Location": {
        "type": "object",
        "required": [
          "lat",
          "lng"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "DriverInput": {
        "type": "object",
        "required": [
          "name",
          "email",
          "phone",
          "carNumber",
          "carModel",
          "location"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$"
          },
          "carNumber": {
            "type": "string"
          },
          "carModel": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          }
        }
      },
      "Driver": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "carNumber",
          "carModel",
          "location",
          "status",
          "rating",
          "lastLoginAt",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$"
          },
          "carNumber": {
            "type": "string"
          },
          "carModel": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "offline",
              "on_trip"
            ]
          },
          "rating": {
            "type": "number"
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TripInput": {
        "type": "object",
        "required": [
          "pickup",
          "dropoff"
        ],
        "properties": {
          "pickup": {
            "$ref": "#/components/schemas/Location"
          },
          "dropoff": {
            "$ref": "#/components/schemas/Location"
          }
        },
        "additionalProperties": false
      },
      "Trip": {
        "type": "object",
        "required": [
          "id",
          "rider_id",
          "pickup",
          "dropoff",
          "status",
          "fare_cents",
          "currency",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          "rider_id": {
            "type": "string",
            "maxLength": 128
          },
          "pickup": {
            "$ref": "#/components/schemas/Location"
          },
          "dropoff": {
            "$ref": "#/components/schemas/Location"
          },
          "driver_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "requested",
              "assigned",
              "in_progress",
              "completed",
              "cancelled"
            ]
          },
          "fare_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Receipt": {
        "type": "object",
        "required": [
          "trip_id",
          "event_id",
          "amount_cents",
          "currency",
          "status",
          "recorded_at"
        ],
        "properties": {
          "trip_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          "event_id": {
            "type": "string"
          },
          "amount_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "simulated_paid"
            ]
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "service",
          "status"
        ],
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "gateway"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "ready"
            ]
          }
        }
      },
      "TripTransition": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "assigned",
              "in_progress",
              "completed",
              "cancelled"
            ]
          },
          "driver_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          }
        }
      },
      "Availability": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "available",
              "offline"
            ]
          }
        }
      },
      "DriverActivity": {
        "type": "object",
        "required": [
          "status",
          "availability",
          "completed_trips"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "available",
              "offline",
              "on_trip"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "offline",
              "on_trip"
            ]
          },
          "active_trip_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          "completed_trips": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "id",
          "email",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "role": {
            "type": "string",
            "enum": [
              "rider",
              "driver",
              "operator"
            ]
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 72,
            "description": "12 to 72 UTF-8 bytes."
          }
        },
        "additionalProperties": false
      },
      "CreateAccount": {
        "type": "object",
        "required": [
          "email",
          "password",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 72,
            "description": "12 to 72 UTF-8 bytes."
          },
          "role": {
            "type": "string",
            "enum": [
              "rider",
              "driver",
              "operator"
            ]
          }
        },
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_at",
          "account"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "account": {
            "$ref": "#/components/schemas/Account"
          }
        }
      }
    },
    "securitySchemes": {
      "accountSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque access token returned by POST /v1/auth/login. Sessions expire after 12 hours and can be revoked with POST /v1/auth/logout."
      }
    }
  }
}
