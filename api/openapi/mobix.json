    "/v1/drivers": {
      "post": {
        "tags": [
          "Drivers"
        ],
        "operationId": "registerDriver",
        "summary": "Register a driver",
        "description": "Driver only. Register one profile linked to your authenticated account. Contact email, phone and license plate must be unique.",
        "responses": {
          "201": {
            "description": "Resource created or previous trip returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Driver"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Relative path of the resource"
              }
            }
          },
          "400": {
            "description": "Invalid request fields or JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "A driver already uses the same email, phone or license plate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "A valid, unexpired account session is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "A required service is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The account role is not allowed to perform this action",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriverInput"
              },
              "example": {
                "name": "Alex Morgan",
                "email": "alex@example.test",
                "phone": "+12025550101",
                "carNumber": "MBX-101",
                "carModel": "Toyota Prius",
                "location": {
                  "lat": 40.73061,
                  "lng": -73.935242
                }
              }
            }
          }
        }
      }
    },
