    "/v1/trips": {
      "post": {
        "tags": [
          "Trips"
        ],
        "operationId": "requestTrip",
        "summary": "Request a ride",
        "description": "Rider only. The authenticated account supplies rider_id. Idempotency-Key is scoped to this rider. The response includes an estimated fare in USD cents.",
        "responses": {
          "201": {
            "description": "Resource created or previous trip returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Relative path of the resource"
              }
            }
          },
          "400": {
            "description": "Invalid request fields or JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "This rider already used the retry key with different trip details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "A valid, unexpired account session is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "A required service is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The account role is not allowed to perform this action",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripInput"
              },
              "example": {
                "pickup": {
                  "lat": 40.73061,
                  "lng": -73.935242
                },
                "dropoff": {
                  "lat": 40.74844,
                  "lng": -73.98566
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Optional retry key scoped to the authenticated rider. Reuse the same key and trip details after a timeout.",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ]
      }
    },
