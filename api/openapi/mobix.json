{
  "openapi": "3.1.0",
  "info": {
    "title": "Mobix API",
    "version": "2.0.0",
    "description": "Operator-provisioned rider, driver and operator accounts with expiring bearer sessions. Riders own their trips, operators dispatch them, and assigned drivers start and complete them."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Accounts"
    },
    {
      "name": "Drivers"
    },
    {
      "name": "Trips"
    },
    {
      "name": "Payments"
    },
    {
      "name": "System"
    }
  ],
  "security": [
    {
      "accountSession": []
    }
  ],
  "paths": {
    "/v1/auth/login": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "operationId": "signIn",
        "summary": "Sign in",
        "description": "Exchange individual account credentials for a 12-hour bearer session.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields or JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Authentication hashing capacity is busy. Retry shortly.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              },
              "example": {
                "email": "operator@mobix.test",
                "password": "your-operator-password"
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/auth/me": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "operationId": "getMyAccount",
        "summary": "Read my account",
        "description": "Read the current signed-in account identity and role.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "operationId": "signOut",
        "summary": "Sign out",
        "description": "Revoke the current session immediately.",
        "responses": {
          "204": {
            "description": "Success"
          },
          "401": {
            "description": "Invalid credentials or session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/accounts": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "operationId": "createAccount",
        "summary": "Provision an account",
        "description": "Operator only. Create an individual rider, driver or operator account.",
